<section class="container categories-section" data-motion-section>
  <div class="section-heading"><div data-motion-heading><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="section-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} ↗</a></div>
  <div class="category-grid" data-motion-grid>
    {% for block in section.blocks %}
      <a class="category-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-motion-card {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 701px) 25vw, 50vw', loading: 'lazy', alt: block.settings.image.alt }}{% else %}{% case forloop.index %}{% when 1 %}{% assign fallback_image = 'photo-1617137968427-85924c800a22' %}{% when 2 %}{% assign fallback_image = 'photo-1483985988355-763728e1935b' %}{% when 3 %}{% assign fallback_image = 'photo-1596462502278-27bfdc403348' %}{% else %}{% assign fallback_image = 'photo-1556911220-bff31c812dba' %}{% endcase %}<img src="https://images.unsplash.com/{{ fallback_image }}?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="{{ block.settings.title | escape }}" width="900" height="1125" loading="lazy">{% endif %}
        <span class="category-overlay"><span><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.copy | escape }}</small></span><span aria-hidden="true">↗</span></span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Category links",
  "max_blocks": 4,
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND YOUR EVERYDAY" }, { "type": "text", "id": "heading", "label": "Heading", "default": "A little something for everyone." }, { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore all" }, { "type": "url", "id": "link", "label": "Link" }],
  "blocks": [{ "type": "category", "name": "Category", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "For Him" }, { "type": "text", "id": "copy", "label": "Description", "default": "Style. Confidence. Character." }, { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "url", "id": "link", "label": "Link" }] }],
  "presets": [{ "name": "Category links", "blocks": [{ "type": "category", "settings": { "title": "For Him" } }, { "type": "category", "settings": { "title": "For Her", "copy": "A little everyday elegance." } }, { "type": "category", "settings": { "title": "Beauty & Care", "copy": "Your daily feel-good ritual." } }, { "type": "category", "settings": { "title": "Kitchen Essentials", "copy": "Make everyday cooking better." } }] }]
}
{% endschema %}