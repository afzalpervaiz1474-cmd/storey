<section class="container catalog" data-motion-section><div class="section-heading"><div data-motion-heading><p class="eyebrow">EXPLORE VERDANT</p><h1>{{ section.settings.heading | escape }}</h1></div></div><div class="category-grid collection-list" data-motion-grid>{% for collection in collections %}{% unless collection.handle == 'frontpage' or collection.handle == 'all' %}<a class="category-card" data-motion-card href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 701px) 25vw, 50vw', loading: 'lazy', alt: collection.featured_image.alt | default: collection.title }}{% endif %}<span class="category-overlay"><span><strong>{{ collection.title | escape }}</strong><small>{{ collection.products_count }} products</small></span><span aria-hidden="true">↗</span></span></a>{% endunless %}{% endfor %}</div></section>
{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop collections"}]}{% endschema %}