<section class="container standard-page" data-motion-section><div class="contact-grid"><div data-motion-heading><p class="eyebrow">WE’RE HERE FOR YOUR EVERYDAY</p><h1 class="page-title">{{ section.settings.heading | escape }}</h1><p class="contact-intro">{{ section.settings.copy | escape }}</p>{% if shop.email != blank %}<div class="contact-item"><strong>Email</strong><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></div>{% endif %}{% if shop.phone != blank %}<div class="contact-item"><strong>Phone</strong><a href="tel:{{ shop.phone }}">{{ shop.phone }}</a></div>{% endif %}</div>
  <div data-motion-panel>{% form 'contact' %}<h2 class="form-subheading">{{ section.settings.form_heading | escape }}</h2>{% if form.posted_successfully? %}<p class="contact-status" role="status">Thanks for contacting us. We’ll get back to you as soon as possible.</p>{% endif %}{{ form.errors | default_errors }}<div class="form-grid"><label class="field field-full" for="ContactName">Your name<input id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required></label><label class="field field-full" for="ContactEmail">Email address<input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></label><label class="field field-full" for="ContactMessage">Your message<textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea></label></div><button class="button button-large" type="submit">Send message →</button>{% endform %}</div>
</div></section>
{% schema %}{"name":"Contact page","settings":[{"type":"text","id":"heading","label":"Heading","default":"Let’s talk."},{"type":"textarea","id":"copy","label":"Introduction","default":"A question about a product, a little help with your order, or simply a hello. We’d love to hear from you."},{"type":"text","id":"form_heading","label":"Form heading","default":"Send a message"}]}{% endschema %}