<section class="hero" data-motion-hero>
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-background motion-parallax-image', widths: '750, 1200, 1800, 2400', sizes: '100vw', fetchpriority: 'high', alt: section.settings.image.alt }}{% else %}<img class="hero-background motion-parallax-image" src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&amp;fit=crop&amp;w=2400&amp;q=85" alt="Warm, considered modern home interior" width="2400" height="1600" fetchpriority="high">{% endif %}
  <div class="hero-inner">
    <div class="hero-copy-block" data-motion-hero-copy><p class="eyebrow"><span class="eyebrow-line"></span>{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}<br><span>{{ section.settings.heading_accent | escape }}</span></h1>
      <p class="hero-copy">{{ section.settings.copy | escape }}</p>
      <div class="hero-actions"><a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% if section.settings.secondary_label != blank %}<a href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
      <p class="hero-note">◇ {{ section.settings.note | escape }}</p>
    </div>
    <div class="hero-badge" data-motion-hero-badge><span aria-hidden="true">✳</span><span>{{ section.settings.badge | escape }}<small>{{ section.settings.badge_note | escape }}</small></span></div>
    <span class="hero-scroll">↓ &nbsp; {{ section.settings.scroll_label | escape }}</span>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ART OF EVERYDAY LIVING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday essentials." },
    { "type": "text", "id": "heading_accent", "label": "Accent heading", "default": "Extraordinarily chosen." },
    { "type": "textarea", "id": "copy", "label": "Description", "default": "Discover thoughtful finds for your home, your style, and your daily rituals. A little better, every day." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Explore for her" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Carefully curated. Securely delivered." },
    { "type": "text", "id": "badge", "label": "Badge title", "default": "Good things. Great everyday." },
    { "type": "text", "id": "badge_note", "label": "Badge description", "default": "Discover your new essentials" },
    { "type": "text", "id": "scroll_label", "label": "Scroll label", "default": "SCROLL TO DISCOVER" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}